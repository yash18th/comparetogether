# ==============================================================================
# FoodCompare Server Environment Configuration
# ==============================================================================
# Port and Server Binding (Production on Render binds to 0.0.0.0 with $PORT)
PORT=3001

# Allowed CORS Origins (Include production Vercel frontend and local development)
CORS_ORIGIN=https://comparetogether.vercel.app

# Database configuration
DATABASE_PATH=./data/foodcompare.db

# Authentication secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production

# ==============================================================================
# Swiggy Official Builders Club MCP Integration (OAuth 2.1 + PKCE)
# Reference: https://mcp.swiggy.com/builders/
# ==============================================================================
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
SWIGGY_MCP_FOOD_ENDPOINT=https://mcp.swiggy.com/food
SWIGGY_OAUTH_CALLBACK_URL=https://comparetogether.vercel.app/api/integrations/swiggy/callback
SWIGGY_CLIENT_ID=your_swiggy_builders_club_client_id
SWIGGY_CLIENT_SECRET=your_swiggy_builders_club_client_secret

# ==============================================================================
# Zomato Authorized Merchant / Partner API
# (Leave blank if enterprise partner credentials are not configured)
# ==============================================================================
ZOMATO_API_KEY=
ZOMATO_BASE_URL=https://api.zomato.com/v2
